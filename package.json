{
  "name": "grasberg",
  "productName": "Grasberg",
  "version": "1.1.0",
  "description": "Local-first desktop client for every major LLM provider (OpenAI, Anthropic, Google Gemini, Amazon Bedrock, DeepSeek, GLM/Zhipu AI, MiniMax, and 120+ OpenAI-compatible presets). Chat and agentic Work modes with secure key storage and SQLite-backed history.",
  "main": "./out/main/index.js",
  "author": "Grasberg contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run build:mobile && npm run build:relay && electron-vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:native-ui": "npm run build:mobile && node scripts/build-native-ui.mjs",
    "build:relay": "esbuild relay/src/index.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --outfile=relay/relay.mjs",
    "dev:mobile": "vite build --watch --config vite.mobile.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "verify:fast": "npm run typecheck && npm run test:unit",
    "verify": "npm test && npm run build && npm run bundle:check && npm run smoke",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xyflow/react": "^12.11.1",
    "highlight.js": "^11.9.0",
    "katex": "^0.17.0",
    "mermaid": "^11.17.2",
    "node-sqlite3-wasm": "^0.8.0",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tesseract.js": "^6.0.1",
    "ws": "^8.21.3",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
