{
  "name": "grasberg",
  "productName": "Grasberg",
  "version": "1.0.0",
  "description": "Local-first desktop client for multiple LLM providers (DeepSeek, GLM/Zhipu AI, MiniMax, and any OpenAI-compatible API). Chat, Cowork and Code modes with secure key storage and SQLite-backed history.",
  "main": "./out/main/index.js",
  "author": "Grasberg contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "verify:fast": "npm run typecheck && npm run test:unit",
    "verify": "npm test && npm run build && npm run bundle:check && npm run smoke",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xyflow/react": "^12.11.1",
    "highlight.js": "^11.9.0",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "node-sqlite3-wasm": "^0.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
